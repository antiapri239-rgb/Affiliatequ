ENABLE_AI_GENERATOR=true
GEMINI_API_KEY=your_gemini_api_key
# The generator currently uses gemini-3.8-flash.
# Optional fallback model after transient failures; must be enabled for your API key.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Time budget untuk generate artikel dalam milidetik (default: 45000).
# Stream akan ditutup rapi sebelum waktu ini habis, agar tidak kena timeout Vercel.
AI_TIME_BUDGET_MS=45000

# Urutan provider AI yang dicoba. Kiri = dicoba pertama, kanan = fallback.
AI_PROVIDER_ORDER=gemini,groq

# Groq API key (dapatkan gratis di https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key

# Model Groq yang dipakai (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
