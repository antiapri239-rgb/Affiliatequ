---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article
  class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-stone-200/80 bg-white shadow-[0_2px_12px_rgba(28,25,23,0.035)] transition duration-300 hover:border-stone-300 hover:shadow-[0_8px_24px_rgba(28,25,23,0.08)]"
  data-product-category={product.category}
>
  <div class="relative aspect-square overflow-hidden bg-stone-100">
    <a
      href={product.shopeeUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Lihat ${product.title} di Shopee`}
    >
      <img
        src={product.image}
        alt={product.title}
        class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.03]"
        loading="lazy"
        width="900"
        height="900"
      />
    </a>
    {product.badge && (
      <span class="pointer-events-none absolute left-2.5 top-2.5 rounded-full border border-white/60 bg-white/90 px-2.5 py-1 text-[10px] font-medium text-stone-800 shadow-sm backdrop-blur sm:left-3 sm:top-3 sm:px-3 sm:text-xs">
        {product.badge}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <h2 class="min-h-10 font-sans text-sm font-medium leading-5 text-stone-900 sm:min-h-12 sm:text-base sm:leading-6">
      <a
        href={product.shopeeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="line-clamp-2 hover:underline focus-visible:outline-none focus-visible:underline"
      >
      {product.title}
      </a>
    </h2>
    <a
      href={product.shopeeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-gray-600 transition-colors hover:text-orange-600 focus-visible:outline-none focus-visible:underline sm:mt-4 sm:text-sm"
    >
      Lihat di Shopee <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
