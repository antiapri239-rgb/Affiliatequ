---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const contactEmail = 'hello@alfeto.com';
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="p:domain_verify" content="63cbf7dea4ba5f9335e79eecc975eb9a" />
    <meta name="description" content="Alfeto | Kurasi & Inspirasi Dekorasi Ruang Aesthetic. Hubungi Alfeto untuk pertanyaan, masukan, atau kerja sama." />
    <title>Kontak Alfeto | Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alfeto" />
    <meta property="og:title" content="Kontak Alfeto | Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic" />
    <meta property="og:description" content="Hubungi Alfeto untuk pertanyaan, masukan, atau kerja sama." />
    <meta property="og:locale" content="id_ID" />
  </head>
  <body class="bg-[#FAF9F6] font-sans antialiased text-gray-900">
    <Header />
    <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <header class="mx-auto max-w-3xl text-center">
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#5c534d]">Kami senang mendengar kabarmu</p>
        <h1 class="mt-5 text-4xl font-medium tracking-tight text-[#121212] sm:text-5xl">Hubungi Alfeto</h1>
        <p class="mt-6 text-base leading-7 text-stone-600">Punya pertanyaan, masukan, atau ide kolaborasi? Kirim pesan kepada kami.</p>
      </header>

      <div class="mx-auto mt-12 grid max-w-5xl gap-12 border-y border-[#e8e0d2] py-10 md:grid-cols-[0.75fr_1.25fr] md:gap-16 md:py-14">
        <section>
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#5c534d]">Surel</p>
          <a href={`mailto:${contactEmail}`} class="mt-3 inline-block break-all text-xl font-medium text-[#121212] underline decoration-[#c5a059]/70 underline-offset-4">{contactEmail}</a>
          <p class="mt-5 max-w-sm text-sm leading-6 text-stone-600">Untuk pertanyaan, masukan, atau kerja sama, sertakan sedikit konteks di dalam pesanmu.</p>
        </section>

        <section>
          <form action={`mailto:${contactEmail}`} method="post" enctype="text/plain" class="space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="block text-xs font-medium text-stone-700">
                Nama
                <input name="name" autocomplete="name" required class="mt-2 block min-h-12 w-full rounded-sm border border-[#d9d2c7] bg-white/80 px-4 text-sm text-[#121212] outline-none transition focus:border-[#c5a059] focus:ring-2 focus:ring-[#c5a059]/20" />
              </label>
              <label class="block text-xs font-medium text-stone-700">
                Surel
                <input name="email" type="email" autocomplete="email" required class="mt-2 block min-h-12 w-full rounded-sm border border-[#d9d2c7] bg-white/80 px-4 text-sm text-[#121212] outline-none transition focus:border-[#c5a059] focus:ring-2 focus:ring-[#c5a059]/20" />
              </label>
            </div>
            <label class="block text-xs font-medium text-stone-700">
              Subjek
              <input name="subject" required class="mt-2 block min-h-12 w-full rounded-sm border border-[#d9d2c7] bg-white/80 px-4 text-sm text-[#121212] outline-none transition focus:border-[#c5a059] focus:ring-2 focus:ring-[#c5a059]/20" />
            </label>
            <label class="block text-xs font-medium text-stone-700">
              Pesan
              <textarea name="message" rows="6" required class="mt-2 block w-full resize-y rounded-sm border border-[#d9d2c7] bg-white/80 px-4 py-3 text-sm leading-6 text-[#121212] outline-none transition focus:border-[#c5a059] focus:ring-2 focus:ring-[#c5a059]/20"></textarea>
            </label>
            <button type="submit" class="inline-flex min-h-12 items-center justify-center border border-[#c5a059] bg-[#121212] px-6 text-[10px] font-semibold uppercase tracking-[0.22em] text-white transition hover:bg-[#292621]">Kirim pesan</button>
            <p class="text-xs leading-5 text-stone-500">Tombol ini akan membuka aplikasi surel bawaan dengan pesanmu. Situs ini tidak menyimpan pesan.</p>
          </form>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>
