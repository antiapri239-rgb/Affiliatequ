---
import fs from 'node:fs';
import path from 'node:path';

const siteUrl = 'https://www.rianticare.com';

const pdir = path.join(process.cwd(), 'src', 'data', 'products');
const produk = fs.readdirSync(pdir)
  .filter((f) => f.endsWith('.json'))
  .map((f) => {
    const d = JSON.parse(fs.readFileSync(path.join(pdir, f), 'utf8'));
    const slug = f.replace(/\.json$/, '');
    return { title: String(d.title ?? slug), url: `${siteUrl}/produk/${slug}`, shopee: d.shopeeUrl || '' };
  })
  .sort((a, b) => a.title.localeCompare(b.title));

const bdir = path.join(process.cwd(), 'src', 'content', 'blog');
const artikel = fs.readdirSync(bdir)
  .filter((f) => /\.mdx?$/.test(f))
  .map((f) => {
    const txt = fs.readFileSync(path.join(bdir, f), 'utf8');
    const m = txt.match(/^title:\s*([\s\S]*?)\n(?=\w+:)/m);
    const title = m ? m[1].replace(/\s*\n\s*/g, ' ').replace(/^["']|["']$/g, '').trim() : f;
    const draft = /^draft:\s*true/m.test(txt);
    const slug = f.replace(/\.mdx?$/, '');
    return { title: draft ? `[DRAFT] ${title}` : title, url: `${siteUrl}/blog/${slug}` };
  })
  .sort((a, b) => a.title.localeCompare(b.title));
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Link untuk Pin</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 p-4 md:p-8 font-sans">
    <div class="max-w-5xl mx-auto bg-white p-6 rounded shadow border">
      <h1 class="text-2xl font-bold mb-1">🔗 Link untuk Pin</h1>
      <p class="text-sm text-gray-500 mb-4">Ketik untuk mencari, lalu klik Salin dan tempel sebagai link tujuan pin.</p>
      <input id="q" type="search" placeholder="Cari produk atau artikel..." class="w-full border rounded p-3 mb-4" />

      <div class="flex gap-2 mb-4">
        <button data-tab="produk" class="tab px-4 py-2 rounded bg-gray-900 text-white text-sm">Produk ({produk.length})</button>
        <button data-tab="artikel" class="tab px-4 py-2 rounded bg-gray-200 text-sm">Artikel ({artikel.length})</button>
      </div>

      <div id="produk" class="panel">
        {produk.map((p) => (
          <div class="row flex items-center gap-3 border-b py-3" data-t={p.title.toLowerCase()}>
            <div class="flex-1 text-sm">{p.title}</div>
            <button class="copy shrink-0 px-3 py-1 rounded bg-blue-600 text-white text-xs" data-url={p.url}>Salin link</button>
            {p.shopee && <button class="copy shrink-0 px-3 py-1 rounded bg-orange-500 text-white text-xs" data-url={p.shopee}>Salin Shopee</button>}
          </div>
        ))}
      </div>

      <div id="artikel" class="panel hidden">
        {artikel.map((a) => (
          <div class="row flex items-center gap-3 border-b py-3" data-t={a.title.toLowerCase()}>
            <div class="flex-1 text-sm">{a.title}</div>
            <button class="copy shrink-0 px-3 py-1 rounded bg-blue-600 text-white text-xs" data-url={a.url}>Salin link</button>
          </div>
        ))}
      </div>
    </div>

    <script is:inline>
      document.querySelectorAll('.copy').forEach((b) => {
        b.addEventListener('click', async () => {
          const old = b.textContent;
          try { await navigator.clipboard.writeText(b.dataset.url); b.textContent = 'Tersalin ✓'; }
          catch (e) { prompt('Salin manual:', b.dataset.url); }
          setTimeout(() => (b.textContent = old), 1200);
        });
      });
      document.querySelectorAll('.tab').forEach((t) => {
        t.addEventListener('click', () => {
          document.querySelectorAll('.panel').forEach((p) => p.classList.add('hidden'));
          document.getElementById(t.dataset.tab).classList.remove('hidden');
          document.querySelectorAll('.tab').forEach((x) => { x.classList.remove('bg-gray-900', 'text-white'); x.classList.add('bg-gray-200'); });
          t.classList.add('bg-gray-900', 'text-white'); t.classList.remove('bg-gray-200');
        });
      });
      document.getElementById('q').addEventListener('input', (e) => {
        const v = e.target.value.toLowerCase();
        document.querySelectorAll('.row').forEach((r) => { r.style.display = r.dataset.t.includes(v) ? '' : 'none'; });
      });
    </script>
  </body>
</html>
