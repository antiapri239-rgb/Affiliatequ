---
import { getCollection } from 'astro:content';
const produkList = await getCollection('produk');
// Pastikan URL ini sesuai dengan domain Vercel kamu
const siteUrl = 'https://rianti.vercel.app'; 
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>Link Pinterest Produk</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 p-8 font-sans">
    <div class="max-w-4xl mx-auto bg-white p-6 rounded shadow border">
      <h1 class="text-2xl font-bold mb-4">🔗 Link Blog untuk Pinterest</h1>
      <p class="text-sm text-gray-500 mb-6">Copy link di kolom biru di bawah ini untuk dijadikan tujuan (Destination) saat bikin Pin.</p>

      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-100 border-b">
            <th class="p-3">Nama Produk</th>
            <th class="p-3">Link Blog (Copy Ini)</th>
          </tr>
        </thead>
        <tbody>
          {produkList.map((produk) => (
            <tr class="border-b">
              <td class="p-3 text-sm">{produk.data.title}</td>
              <td class="p-3 text-sm text-blue-600 break-all font-mono">
                {`${siteUrl}/produk/${produk.id}`}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </body>
</html>
