---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { categoryLabels } from '../../data/categories';
import { isBlogPostPublished } from '../../data/blog-publication';
import '../../styles/global.css';

const buildTime = new Date();
const posts = (await getCollection('blog', ({ data }) => isBlogPostPublished(data, buildTime))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="p:domain_verify" content="63cbf7dea4ba5f9335e79eecc975eb9a" />
    <meta name="description" content="Alfeto | Kurasi & Inspirasi Dekorasi Ruang Aesthetic. Artikel, inspirasi, dan panduan dekorasi." />
    <title>Blog | Alfeto — Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alfeto" />
    <meta property="og:title" content="Blog | Alfeto — Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic" />
    <meta property="og:description" content="Artikel, inspirasi, dan panduan dekorasi dari Alfeto." />
    <meta property="og:locale" content="id_ID" />
  </head>
  <body class="min-h-screen bg-[#faf9f6] font-sans antialiased text-gray-900">
    <Header />

    <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-16 lg:px-8">
      <div class="mb-9 hidden max-w-3xl sm:block">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#c5a059]">Blog dekorasi</p>
        <h1 class="mt-3 text-3xl font-medium tracking-tight text-stone-900 sm:text-5xl">Blog Alfeto</h1>
        <p class="mt-4 text-base leading-7 text-stone-600 sm:text-lg">
          Inspirasi dan panduan praktis untuk membuat rumah terasa makin nyaman, personal, dan estetik.
        </p>
      </div>

      <div class="mt-8 grid gap-5">
        {posts.map((post) => (
          <article class="group overflow-hidden rounded-[1.8rem] border border-stone-200 bg-white shadow-[0_18px_50px_-36px_rgba(18,18,18,0.5)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_28px_80px_-42px_rgba(18,18,18,0.55)] sm:grid sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
            <a href={`/blog/${post.id}/`} class="block aspect-[4/3] overflow-hidden bg-stone-100 sm:aspect-auto">
              <img
                src={post.data.heroImage}
                alt=""
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                loading="lazy"
                width="1200"
                height="900"
              />
            </a>
            <div class="p-5 sm:p-7">
              <div class="flex items-center justify-between gap-3">
                <p class="inline-flex rounded-full border border-[#d7bb72]/60 bg-[#f4efe8] px-2.5 py-1 text-[9px] font-semibold uppercase tracking-[0.16em] text-[#5c534d] sm:text-[10px]">
                  {categoryLabels[post.data.category]}
                </p>
                <p class="text-[10px] text-stone-500 sm:text-xs">
                  {dateFormatter.format(post.data.pubDate)}
                </p>
              </div>
              <h2 class="mt-4 text-xl font-semibold leading-snug text-stone-900 sm:text-2xl">
                <a class="transition hover:text-[#c5a059]" href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="mt-3 text-sm leading-6 text-stone-600 sm:text-[0.97rem]">{post.data.description}</p>
              {post.data.advanced.tags.length > 0 && (
                <ul class="mt-4 hidden flex-wrap gap-2 sm:flex" aria-label="Tag artikel">
                  {post.data.advanced.tags.map((tag) => (
                    <li class="rounded-full bg-stone-100 px-2.5 py-1 text-[10px] font-medium text-stone-600">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
              <div class="mt-5 flex items-center justify-between gap-3">
                <p class="text-[11px] text-stone-500">{post.data.author}</p>
                <a
                  class="inline-flex items-center text-sm font-semibold text-[#121212] transition hover:text-[#c5a059]"
                  href={`/blog/${post.id}/`}
                >
                  Baca artikel <span aria-hidden="true" class="ml-1">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </main>

    <Footer />
  </body>
</html>
