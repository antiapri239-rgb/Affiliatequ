---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const terms = (await getCollection('kamus')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'id'),
);
---

<html lang="id">
  <head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6034629416430208" crossorigin="anonymous"></script>
    <meta name="p:domain_verify" content="29fa6b98e33108d592c8f17dc1506eaf" />
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Kamus istilah skincare: arti dan penjelasan istilah perawatan kulit berdasarkan sumber kesehatan resmi." />
    <title>Kamus Istilah Skincare | Rianti</title>
  </head>
  <body class="min-h-screen bg-[#faf9f6] font-sans antialiased text-gray-900">
    <Header />
    <main>
      <section class="mx-auto max-w-3xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        <h1 class="mb-2 text-2xl font-medium tracking-tight text-stone-950 sm:text-3xl">Kamus Istilah Skincare</h1>
        <p class="mb-6 text-sm text-stone-600">Arti istilah perawatan kulit, disusun dari sumber kesehatan resmi. Tiap istilah mencantumkan sumbernya.</p>
        <ul class="grid gap-3">
          {terms.map((term) => (
            <li class="rounded-2xl border border-stone-200 bg-white p-4 transition hover:border-stone-400">
              <a href={`/kamus/${term.id}/`} class="block">
                <span class="block text-base font-medium text-stone-900">{term.data.title}</span>
                <span class="mt-1 block text-sm text-stone-600">{term.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
