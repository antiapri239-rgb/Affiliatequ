---
import { inject } from "@vercel/analytics";
import ProductCard from '../components/ProductCard.astro';
import { categoryLabels, productCategories, products } from '../data/products';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { categoryLabels as blogCategoryLabels } from '../data/categories';
import { isBlogPostPublished } from '../data/blog-publication';
import '../styles/global.css';

const buildTime = new Date();
const latestPosts = (await getCollection('blog', ({ data }) => isBlogPostPublished(data, buildTime)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const dateFormatter = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<html lang="id">
  <head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6034629416430208" crossorigin="anonymous"></script>
    <meta name="p:domain_verify" content="29fa6b98e33108d592c8f17dc1506eaf" />
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Rianti | Inspirasi Skincare untuk Kulit Sehat & Glowing. Temukan produk skincare, tips perawatan kulit, dan rutinitas harian untuk kulit sehat."
    />
    <title>Rianti | Inspirasi Skincare untuk Kulit Sehat &amp; Glowing</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rianti" />
    <meta property="og:title" content="Rianti | Inspirasi Skincare untuk Kulit Sehat &amp; Glowing" />
    <meta
      property="og:description"
      content="Kurasi produk skincare dan tips perawatan kulit untuk kulit sehat & glowing."
    />
    <meta property="og:locale" content="id_ID" />
    <link rel="preconnect" href="https://images.unsplash.com" />
  </head>
  <body class="min-h-screen bg-[#faf9f6] font-sans antialiased text-gray-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        <div class="max-w-3xl">
          <h1 class="max-w-2xl text-2xl font-medium leading-tight tracking-tight text-stone-950 sm:text-4xl">
            Inspirasi Skincare untuk Kulit Sehat & Glowing
          </h1>
          <p class="mt-3 max-w-xl text-sm leading-6 text-stone-600 sm:text-base sm:leading-7">
            Kurasi produk skincare, tips perawatan kulit, dan rutinitas harian untuk kulit yang lebih sehat.
          </p>
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 sm:pb-10 lg:px-8">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-xl font-medium tracking-tight text-stone-950 sm:text-2xl">Artikel Terbaru</h2>
          <a href="/blog/" class="shrink-0 text-sm font-medium text-stone-600 transition hover:text-[#c5a059]">Lihat semua artikel →</a>
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
          {latestPosts.map((post, i) => (
            <article class="group overflow-hidden rounded-xl border border-stone-200/80 bg-white shadow-[0_2px_12px_rgba(28,25,23,0.035)] transition duration-300 hover:border-stone-300 hover:shadow-[0_8px_24px_rgba(28,25,23,0.08)]">
              <a href={`/blog/${post.id}/`} class="block aspect-[4/3] overflow-hidden bg-stone-100">
                <img
                  src={post.data.heroImage}
                  alt=""
                  class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.03]"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  width="1200"
                  height="900"
                />
              </a>
              <div class="p-4">
                <div class="flex items-center justify-between gap-3">
                  <p class="inline-flex rounded-full border border-[#d7bb72]/60 bg-[#f4efe8] px-2.5 py-1 text-[9px] font-semibold uppercase tracking-[0.16em] text-[#5c534d] sm:text-[10px]">
                    {blogCategoryLabels[post.data.category]}
                  </p>
                  <p class="text-[10px] text-stone-500 sm:text-xs">{dateFormatter.format(post.data.pubDate)}</p>
                </div>
                <h3 class="mt-3 text-base font-semibold leading-snug text-stone-900">
                  <a class="transition hover:text-[#c5a059]" href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-stone-600">{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="katalog" class="mx-auto max-w-7xl scroll-mt-6 px-4 pb-10 sm:px-6 sm:pb-12 lg:px-8">
        <div class="hidden">
          <div class="flex items-baseline gap-3">
            <h2 class="text-xl font-medium tracking-tight text-stone-950 sm:text-2xl">
              Katalog Skincare
            </h2>
            <p class="shrink-0 text-xs text-stone-500 sm:text-sm">{products.length} pilihan</p>
          </div>

          <div class="hidden">
            <div class="hidden" role="group" aria-label="Filter kategori produk">
              <button
                type="button"
                data-category-filter="all"
                aria-pressed="true"
                class="rounded-full border border-stone-900 bg-stone-900 px-4 py-2 text-xs font-medium text-white transition-colors hover:bg-stone-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-500 focus-visible:ring-offset-2 sm:text-sm"
              >
                ALL
              </button>
              {productCategories.filter((category) => products.some((product) => product.category === category)).map((category) => (
                <button
                  type="button"
                  data-category-filter={category}
                  aria-pressed="false"
                  class="rounded-full border border-stone-300 bg-transparent px-4 py-2 text-xs font-medium text-stone-600 transition-colors hover:border-stone-500 hover:text-stone-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-500 focus-visible:ring-offset-2 sm:text-sm"
                >
                  {categoryLabels[category]}
                </button>
              ))}
            </div>
          </div>
        </div>

        <h2 class="mb-4 text-xl font-medium tracking-tight text-stone-950 sm:text-2xl">Katalog Produk</h2>
        <div class="mt-2 grid grid-cols-2 gap-x-3 gap-y-7 sm:gap-x-5 sm:gap-y-9 lg:grid-cols-3 xl:grid-cols-4">
          {products.map((product) => <ProductCard product={product} />)}
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
      const productCards = document.querySelectorAll<HTMLElement>('[data-product-category]');

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const selectedCategory = button.dataset.categoryFilter;

          filterButtons.forEach((filterButton) => {
            const isSelected = filterButton === button;
            filterButton.setAttribute('aria-pressed', String(isSelected));
            filterButton.classList.toggle('bg-stone-900', isSelected);
            filterButton.classList.toggle('text-white', isSelected);
            filterButton.classList.toggle('border-stone-900', isSelected);
            filterButton.classList.toggle('bg-transparent', !isSelected);
            filterButton.classList.toggle('text-stone-600', !isSelected);
            filterButton.classList.toggle('border-stone-300', !isSelected);
          });

          productCards.forEach((card) => {
            card.hidden =
              selectedCategory !== 'all' &&
              card.dataset.productCategory !== selectedCategory;
          });
        });
      });
    </script>
  <script>import { inject } from "@vercel/analytics"; inject();</script>
</body>
